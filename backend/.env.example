# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never put these values in the frontend.

APP_NAME=VulnSight API
APP_VERSION=0.1.0
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use the DIRECT Neon connection string (not the -pooler endpoint).
# The backend converts the scheme to postgresql+asyncpg:// and enables TLS.
# Example shape:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Only these hostnames may be scanned. Exact matches only; no wildcards.
# Add a host deliberately when you have authorization to test it.
SCAN_ALLOWED_HOSTS=127.0.0.1,localhost,::1
SCAN_MAX_TARGETS=10
SCAN_ALLOW_LOOPBACK_FOR_TESTING=true
SCAN_EXECUTOR_MODE=recon

# Reconnaissance & Scanner Controls
RECON_REQUEST_TIMEOUT=8.0
RECON_RATE_LIMIT_DELAY=0.05
RECON_MAX_REDIRECTS=5
RECON_USER_AGENT=VulnSight-Security-Scanner/1.0 (+https://github.com/vulnsight)
